      "post": {
        "tags": [
          "Simulator"
        ],
        "summary": "Post Whatif",
        "description": "Recompute inventory decisions (SS, ROP, EOQ, days_remaining, status, stockout probability).\n\nAccepts raw parameters directly (matching tests/inventory_fixtures.json)\nor resolves defaults from a specified material & area.",
        "operationId": "post_whatif_whatif_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
